# ==============================================================================
# ChildInsight — Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your local or production environment.
# ==============================================================================

# --- Flask Environment & Runtime ---
# Options: development, testing, production
FLASK_CONFIG=development
FLASK_APP=run.py
FLASK_DEBUG=1

# --- Security & Session Signing ---
# CRITICAL: In production, generate a cryptographically strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-childinsight-change-in-prod-replace-with-uuid
# Enforced as True automatically in production (requires HTTPS):
SESSION_COOKIE_SECURE=False

# --- Database Connection URLs ---
# Default Local Development (SQLite):
DATABASE_URL=sqlite:///database/childinsight_dev.db

# Production PostgreSQL Example (Render / Supabase / AWS RDS / Neon):
# Format: postgresql://<username>:<password>@<hostname>:<port>/<database_name>
# DATABASE_URL=postgresql://childinsight_user:StrongPasswordHere@localhost:5432/childinsight_db

# Production MySQL Example:
# Format: mysql+pymysql://<username>:<password>@<hostname>:<port>/<database_name>
# DATABASE_URL=mysql+pymysql://childinsight_user:StrongPasswordHere@localhost:3306/childinsight_db

# --- Logging Configuration ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/childinsight.log

# --- CSRF Protection ---
# Keep True for all environments except automated test suites
WTF_CSRF_ENABLED=True
